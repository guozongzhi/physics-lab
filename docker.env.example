# 复制为 .env（供 docker compose 读取）后填入真实值；.env 已被 .gitignore 忽略，勿提交。
# 生产环境建议用长随机串：openssl rand -hex 32

# 后端密钥
JWT_SECRET=change-me-openssl-rand-hex-32
# NFC 卡片索引密钥；启用终端时生成并持久保存，留空则 NFC 查询返回 503。
NFC_UID_SECRET=
# 下面三个务必填你自己的强密码，不要照抄任何示例值
TEACHER_PASSWORD=
ADMIN_PASSWORD=
STUDENT_DEFAULT_PASSWORD=

# 前端同源地址（构建期烘焙；改端口/域名需重新 docker compose build）
VITE_API_BASE_URL=http://localhost:8080

# 宿主机端口（前端）
WEB_PORT=8080
